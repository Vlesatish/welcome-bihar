# ========================================================
# WELCOME BIHAR - ENVIRONMENT CONFIGURATION
# Note: Keep this file secure. Never commit live production secrets.
# ========================================================

APP_NAME="Welcome Bihar"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Kolkata
APP_DEFAULT_LANG=en

# Database Configuration (MySQL / MariaDB via PDO)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=welcome_bihar
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Session & Security
SESSION_LIFETIME=7200
CSRF_SECRET=change-me-to-a-secure-random-32-byte-hex-string

# ALL API UPI QR Service Configuration
# Note: ALL API is a UPI QR code generation and status tracking service.
# Merchant must connect their own eligible UPI merchant account.
ALLAPI_BASE_URL=https://allapi.in
ALLAPI_CREATE_ENDPOINT=/order/create
ALLAPI_STATUS_ENDPOINT=/order/status
ALLAPI_TOKEN=your_allapi_token_here
ALLAPI_MODE=SANDBOX
ALLAPI_REDIRECT_URL=http://localhost:8080/wallet/topup/callback
ALLAPI_TIMEOUT_SECONDS=10

# Upload Security
MAX_UPLOAD_SIZE_MB=5
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png
