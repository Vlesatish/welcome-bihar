# ========================================================
# WELCOME BIHAR - PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env on your production server.
# Set file permissions strictly: chmod 600 .env
# Never commit the populated .env file to public version control.
# ========================================================

# Application Core Configuration
APP_NAME="Welcome Bihar"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://welcomebihar.example.gov.in
APP_TIMEZONE=Asia/Kolkata
APP_DEFAULT_LANG=en

# Database Configuration (Production MySQL / MariaDB)
# Recommendation: Use a dedicated non-root user with access restricted to welcome_bihar DB.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=welcome_bihar
DB_USER=welcome_bihar_user
DB_PASS=REPLACE_WITH_STRONG_GENERATED_PASSWORD
DB_CHARSET=utf8mb4

# Session & Security
# Generate a new 64-character secret using: openssl rand -hex 32
SESSION_LIFETIME=7200
CSRF_SECRET=GENERATE_SECURE_RANDOM_64_CHAR_HEX_KEY

# ALL API Live Merchant Gateway Configuration
# Mode MUST be set to LIVE in production (SANDBOX is disabled in APP_ENV=production).
ALLAPI_BASE_URL=https://allapi.in
ALLAPI_CREATE_ENDPOINT=/order/create
ALLAPI_STATUS_ENDPOINT=/order/status
ALLAPI_TOKEN=REPLACE_WITH_PRODUCTION_ALLAPI_MERCHANT_TOKEN
ALLAPI_MODE=LIVE
ALLAPI_REDIRECT_URL=https://welcomebihar.example.gov.in/wallet/topup/callback
ALLAPI_TIMEOUT_SECONDS=15

# Upload Security & File Handling
MAX_UPLOAD_SIZE_MB=5
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png

# WhatsApp WBAPI Notification Configuration
# Provider: WBAPI (https://wbapi.in)
WHATSAPP_ENABLED=true
WHATSAPP_API_BASE_URL=https://wbapi.in
WHATSAPP_API_TOKEN=REPLACE_WITH_PRODUCTION_WBAPI_X_API_KEY
WHATSAPP_SESSION_ID=REPLACE_WITH_PRODUCTION_CONNECTED_SESSION_ID
WHATSAPP_DEFAULT_COUNTRY_CODE=91
