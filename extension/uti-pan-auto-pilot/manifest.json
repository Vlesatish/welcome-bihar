{
  "manifest_version": 3,
  "name": "Welcome Bihar - UTI PAN Auto-Pilot",
  "version": "1.0.0",
  "description": "Auto-polls Welcome Bihar PAN Card queue and auto-fills UTIITSL PAN Form No. 93",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://www.myutiitsl.com/*",
    "https://myutiitsl.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Welcome Bihar UTI PAN Auto-Pilot"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.myutiitsl.com/*",
        "https://myutiitsl.com/*"
      ],
      "js": [
        "content/uti_pan_auto.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
