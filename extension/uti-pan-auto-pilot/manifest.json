{
  "manifest_version": 3,
  "name": "Welcome Bihar - UTI PAN Auto-Pilot",
  "version": "1.0.0",
  "description": "Auto-polls Welcome Bihar PAN Card queue, auto-fills UTIITSL PAN Form No. 93 and executes CSC Wallet payment",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://www.myutiitsl.com/*",
    "https://myutiitsl.com/*",
    "https://wallet.csccloud.in/*",
    "https://connect.csc.gov.in/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Welcome Bihar UTI PAN Auto-Pilot"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.myutiitsl.com/*",
        "https://myutiitsl.com/*"
      ],
      "js": [
        "content/uti_pan_auto.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://wallet.csccloud.in/*"
      ],
      "js": [
        "content/csc_wallet_auto.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://connect.csc.gov.in/*"
      ],
      "js": [
        "content/csc_connect_auto.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*"
      ],
      "matches": [
        "https://www.myutiitsl.com/*",
        "https://myutiitsl.com/*"
      ]
    }
  ]
}
